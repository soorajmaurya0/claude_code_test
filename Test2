+    pollUpdateTask(taskUri, timerId) {
+      setTimeout(async () => {
+        const taskState = await this.$store.dispatch(
+          'firmware/getTaskState',
+          taskUri,
+        );
+        // Stop if the 6 minute verify update timer already ended the update
+        if (!this.loading) return;
+        if (taskState === 'Completed') {
+          clearTimeout(timerId);
+          this.endLoader();
+          this.successToast(
+            i18n.global.t('pageFirmware.toast.updateSuccessful'),
+          );
